 void Axp2101::PowerOff() {
-    uint8_t value = ReadReg(0x10);
-    value = value | 0x01;
-    WriteReg(0x10, value);
+    uint8_t value = 0;
+    esp_err_t err = TryReadReg(0x10, &value);
+    if (err != ESP_OK) {
+        ESP_LOGE(TAG, "Power-off register read failed (%s); refusing fatal reboot",
+                 esp_err_to_name(err));
+        return;
+    }
+
+    err = TryWriteReg(0x10, value | 0x01);
+    if (err != ESP_OK) {
+        ESP_LOGE(TAG, "Power-off register write failed (%s); device remains on",
+                 esp_err_to_name(err));
+    }
