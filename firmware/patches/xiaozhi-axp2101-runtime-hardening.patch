diff --git a/main/boards/common/i2c_device.h b/main/boards/common/i2c_device.h
--- a/main/boards/common/i2c_device.h
+++ b/main/boards/common/i2c_device.h
@@ -13,6 +13,8 @@
     void WriteReg(uint8_t reg, uint8_t value);
     uint8_t ReadReg(uint8_t reg);
     void ReadRegs(uint8_t reg, uint8_t* buffer, size_t length);
+    esp_err_t TryReadReg(uint8_t reg, uint8_t* value, int timeout_ms = 100);
+    esp_err_t TryWriteReg(uint8_t reg, uint8_t value, int timeout_ms = 100);
     esp_err_t TryReadRegs(uint8_t reg, uint8_t* buffer, size_t length, int timeout_ms = 100);
 };
 
 diff --git a/main/boards/common/i2c_device.cc b/main/boards/common/i2c_device.cc
--- a/main/boards/common/i2c_device.cc
+++ b/main/boards/common/i2c_device.cc
@@ -1,6 +1,8 @@
 #include "i2c_device.h"
 
 #include <esp_log.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
 
 #define TAG "I2cDevice"
 
@@ -30,6 +32,39 @@
     return buffer[0];
 }
 
+esp_err_t I2cDevice::TryReadReg(uint8_t reg, uint8_t* value, int timeout_ms) {
+    esp_err_t last_error = ESP_FAIL;
+    for (int attempt = 1; attempt <= 3; ++attempt) {
+        last_error = i2c_master_transmit_receive(i2c_device_, &reg, 1, value, 1, timeout_ms);
+        if (last_error == ESP_OK) {
+            return ESP_OK;
+        }
+        ESP_LOGW(TAG, "Read reg 0x%02X failed (%s), attempt %d/3",
+                 reg, esp_err_to_name(last_error), attempt);
+        if (attempt < 3) {
+            vTaskDelay(pdMS_TO_TICKS(20));
+        }
+    }
+    return last_error;
+}
+
+esp_err_t I2cDevice::TryWriteReg(uint8_t reg, uint8_t value, int timeout_ms) {
+    uint8_t buffer[2] = {reg, value};
+    esp_err_t last_error = ESP_FAIL;
+    for (int attempt = 1; attempt <= 3; ++attempt) {
+        last_error = i2c_master_transmit(i2c_device_, buffer, 2, timeout_ms);
+        if (last_error == ESP_OK) {
+            return ESP_OK;
+        }
+        ESP_LOGW(TAG, "Write reg 0x%02X failed (%s), attempt %d/3",
+                 reg, esp_err_to_name(last_error), attempt);
+        if (attempt < 3) {
+            vTaskDelay(pdMS_TO_TICKS(20));
+        }
+    }
+    return last_error;
+}
+
 void I2cDevice::ReadRegs(uint8_t reg, uint8_t* buffer, size_t length) {
     ESP_ERROR_CHECK(i2c_master_transmit_receive(i2c_device_, &reg, 1, buffer, length, 100));
 }
